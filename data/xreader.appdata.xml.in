<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <!-- Releases added by tools/bump-version.sh -->

 <id>xreader.desktop</id>
 <metadata_license>CC0-1.0</metadata_license>
 <project_license>GPL-2.0+</project_license>
 <name>Document Viewer</name>
 <_summary>A Document Viewer</_summary>
 <_description>
  <p>
   Xreader is a simple multi-page document viewer. It can display and
   print PostScript (PS), Encapsulated PostScript (EPS), DJVU, DVI,
   XPS and Portable Document Format (PDF) files, as well as comic book
   archive files. When supported by the document, it also allows
   searching for text, copying text to the clipboard, hypertext navigation
   and table-of-contents bookmarks.
  </p>
 </_description>
 <url type="homepage">http://github.com/linuxmint/xreader</url>
 <project_group>Linux Mint</project_group>
  <releases>
    <release version="4.7.0" date="2026-07-28">
      <description>
        <p>31 self-PRs landed in the yuri-schmaltz/xreader fork, covering:</p>
        <ul>
          <li>4 command-injection / buffer-overflow security fixes (PRs #1, #2, #10, #18)</li>
          <li>5 GTK_STOCK_* deprecation cleanups (PRs #3-#7)</li>
          <li>16 icon name modernizations to xsi-*-symbolic (PRs #14, #15)</li>
          <li>CI hardening: strict-warnings + ASan/UBSan + 60s libFuzzer smoke (PRs #8, #19)</li>
          <li>New libFuzzer harness with seed corpus (PRs #13, #29)</li>
          <li>Unit test bootstrap (PRs #11, #25, #31)</li>
          <li>System libzip migration (PR #12, removes 3,067 lines of embedded minizip)</li>
          <li>Developer tooling: .editorconfig, .clang-format, HACKING.md, RELEASE.md, NEWS, SECURITY.md, .mailmap (PRs #16, #17, #20-#22)</li>
          <li>Various: ev_stock_icons xsi migration, gtk_dialog_get_action_area cleanup, afmparse.c g_strdup, g_build_filename in epub (PRs #15, #27, #28, #30)</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
