{
  "app-id": "io.github.yuri_schmaltz.Xreader",
  "runtime": "org.gnome.Platform",
  "runtime-version": "45",
  "sdk": "org.gnome.Sdk",
  "sdk-version": "45",
  "command": "xreader",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--filesystem=host",
    "--filesystem=xdg-documents",
    "--filesystem=xdg-download",
    "--talk-name=org.gnome.Shell.Extensions.PdfThumbnails"
  ],
  "modules": [
    {
      "name": "xreader",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=/app/lib"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/yuri-schmaltz/xreader.git",
          "tag": "v4.7.0"
        }
      ],
      "modules": [
        {
          "name": "libxapp",
          "buildsystem": "meson",
          "sources": [
            {
              "type": "git",
              "url": "https://github.com/linuxmint/xapp.git",
              "tag": "2.8.2"
            }
          ]
        },
        {
          "name": "xapp-symbolic-icons",
          "buildsystem": "meson",
          "sources": [
            {
              "type": "git",
              "url": "https://github.com/linuxmint/xapp-symbolic-icons.git",
              "tag": "2.0.0"
            }
          ]
        }
      ]
    }
  ]
}
